# The published JAR contains the unmodified normative OMG DDS-Java 1.0 API.
set(OMG_DDS_API_JAR "" CACHE FILEPATH "Local org.omg.dds:java5-psm:1.0 JAR for offline builds")
set(_omg_sha256 "6ac768da86df38116398081240761b4d1ad1b12a9b09ab60b8fc07b0a1a8b2fd")
set(_omg_artifact "org/omg/dds/java5-psm/1.0/java5-psm-1.0.jar")
set(_omg_download "${CMAKE_BINARY_DIR}/_deps/java5-psm-1.0.jar")
if(OMG_DDS_API_JAR)
  get_filename_component(_omg_input "${OMG_DDS_API_JAR}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
elseif(EXISTS "${_omg_download}")
  set(_omg_input "${_omg_download}")
elseif(EXISTS "$ENV{HOME}/.m2/repository/${_omg_artifact}")
  set(_omg_input "$ENV{HOME}/.m2/repository/${_omg_artifact}")
else()
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/_deps")
  foreach(_omg_repository IN ITEMS "https://repo.maven.apache.org/maven2"
      "https://maven-central.storage-download.googleapis.com/maven2")
    message(STATUS "Resolving org.omg.dds:java5-psm:1.0 from ${_omg_repository}")
    file(DOWNLOAD "${_omg_repository}/${_omg_artifact}" "${_omg_download}.tmp"
      TLS_VERIFY ON TIMEOUT 60 STATUS _omg_status)
    list(GET _omg_status 0 _omg_code)
    if(_omg_code EQUAL 0)
      file(SHA256 "${_omg_download}.tmp" _omg_actual_sha256)
      if(NOT _omg_actual_sha256 STREQUAL _omg_sha256)
        file(REMOVE "${_omg_download}.tmp")
        message(FATAL_ERROR "Checksum mismatch for org.omg.dds:java5-psm:1.0")
      endif()
      file(RENAME "${_omg_download}.tmp" "${_omg_download}")
      break()
    endif()
    file(REMOVE "${_omg_download}.tmp")
    message(STATUS "OMG API download failed: ${_omg_status}")
  endforeach()
  set(_omg_input "${_omg_download}")
endif()
if(NOT EXISTS "${_omg_input}")
  message(FATAL_ERROR "Cannot resolve org.omg.dds:java5-psm:1.0; supply -DOMG_DDS_API_JAR=/path/to/java5-psm-1.0.jar for an offline build")
endif()
file(SHA256 "${_omg_input}" _omg_actual_sha256)
if(NOT _omg_actual_sha256 STREQUAL _omg_sha256)
  message(FATAL_ERROR "Checksum mismatch for org.omg.dds:java5-psm:1.0: ${_omg_input}")
endif()
# Keep the installed API filename and existing Java target interfaces stable.
configure_file("${_omg_input}" "${CMAKE_BINARY_DIR}/omg-dds-api.jar" COPYONLY)
add_library(omg-dds-api STATIC IMPORTED GLOBAL)
set_target_properties(omg-dds-api PROPERTIES
  IMPORTED_LOCATION "${CMAKE_BINARY_DIR}/omg-dds-api.jar"
  JAR_FILE "${CMAKE_BINARY_DIR}/omg-dds-api.jar")
install(FILES "${CMAKE_BINARY_DIR}/omg-dds-api.jar" DESTINATION share/java)
